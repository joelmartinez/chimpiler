<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Chimpiler.Core\Chimpiler.Core.csproj" />
    <ProjectReference Include="..\Chimpiler.Dacpac\Chimpiler.Dacpac.csproj" />
    <ProjectReference Include="..\Chimpiler.Kb\Chimpiler.Kb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\cli\ef-migrate.md" Link="Resources\ef-migrate.md" />
    <EmbeddedResource Include="..\..\docs\cli\clawcker.md" Link="Resources\clawcker.md" />
    <EmbeddedResource Include="..\..\docs\cli\dacpac.md" Link="Resources\dacpac.md" />
    <EmbeddedResource Include="..\..\docs\cli\kb.md" Link="Resources\kb.md" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>chimpiler</ToolCommandName>
    <PackageId>Chimpiler</PackageId>
    <Version>0.9.0</Version>
    <Authors>Joel Martinez</Authors>
    <Description>Agent-ready local GraphRAG and .NET CLI tooling</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/joelmartinez/chimpiler</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/joelmartinez/chimpiler</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dotnet;cli;agent;ai;efcore;dacpac;openclaw;clawcker;rag;graphrag;knowledge-base</PackageTags>
  </PropertyGroup>

</Project>
